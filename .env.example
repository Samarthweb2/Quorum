# Copy this file to .env for local development. Do not commit real credentials.
# On Render, set the same keys in the service Environment tab (do not bake secrets into render.yaml).

# Required to send OTP / password-reset email (Gmail example: smtp.gmail.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional. Defaults to SMTP_USER. Use a full From address if your provider requires it.
SMTP_FROM=

# Port 587 uses STARTTLS. For implicit TLS (port 465), set SMTP_SSL=true instead.
# SMTP_STARTTLS=true
# SMTP_SSL=false
