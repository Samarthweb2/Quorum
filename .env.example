# Copy this file to .env for local development. Do not commit real credentials.
# On Render, set the same keys in the service Environment tab (do not bake secrets into render.yaml).

# =============================================================
# Email delivery — configure ONE of the two options below.
# SendGrid is recommended on Render because raw SMTP ports
# (587/465) are often blocked by cloud providers for anti-spam.
# =============================================================

# --- Option A: SendGrid Web API (RECOMMENDED) ---
# Sign up at https://sendgrid.com/ for a free tier (100/day).
# Create an API key with "Mail Send" permission and a Verified Sender.
SENDGRID_API_KEY=
SENDGRID_FROM=

# --- Option B: Raw SMTP (Gmail example: smtp.gmail.com) ---
# Required only if you don't use SendGrid above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional. Defaults to SMTP_USER. Use a full From address if your provider requires it.
SMTP_FROM=

# Port 587 uses STARTTLS. For implicit TLS (port 465), set SMTP_SSL=true instead.
# SMTP_STARTTLS=true
# SMTP_SSL=false

# =============================================================
# Optional: Override auth behaviour
# =============================================================

# Force dev mode even on Render: OTP shown on-screen, no real email sent.
# Useful for quick smoke testing — do NOT leave enabled in production.
# QUORUM_AUTH_DEV=false

# Force real-email required even in local dev. Defaults to true when RENDER=true.
# QUORUM_REQUIRE_SMTP=true

# Persistent path for users.json. Render's free-tier filesystem is EPHEMERAL.
# On paid Render you can mount a Disk and point QUORUM_USERS_PATH to it here.
# QUORUM_USERS_PATH=
